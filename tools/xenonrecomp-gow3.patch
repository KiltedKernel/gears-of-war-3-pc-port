+// float -> uint32 with saturation: NaN and negatives -> 0, >= 2^32 -> 0xFFFFFFFF (PPC vctuxs)
+inline float ppc_half_to_float(uint16_t h)
+{
+    const uint32_t sign = uint32_t(h & 0x8000) << 16, exp = (h >> 10) & 0x1F, man = h & 0x3FF;
+    uint32_t bits;
+    if (exp == 0)
+    {
+        if (man == 0) bits = sign;
+        else { int e = -1; uint32_t m = man; do { e++; m <<= 1; } while (!(m & 0x400)); bits = sign | uint32_t(127 - 15 - e) << 23 | (m & 0x3FF) << 13; }
+    }
+    else if (exp == 31) bits = sign | 0x7F800000 | man << 13;
+    else bits = sign | (exp + 112) << 23 | man << 13;
+    float f; memcpy(&f, &bits, 4); return f;
+}
